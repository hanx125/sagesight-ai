# ========================================
# 白名单模式：默认忽略所有文件，仅上传指定文件到远程仓库
# ========================================
# 工作原理：
#   1. `*`           默认忽略所有文件
#   2. `!*/`         允许进入所有目录（必须，否则无法访问子目录中的文件）
#   3. `!*.py` 等    显式允许指定文件类型
#   4. 末尾的显式忽略（如 `*.onnx`、`output/`）覆盖允许规则，确保大文件/敏感文件不被提交
# ========================================

# 默认忽略所有文件
*

# 允许进入所有目录（必须放在允许文件类型之前）
!*/

# ========================================
# 允许上传的文件类型
# ========================================
# 源代码
!*.py

# 配置文件
!*.yaml
!*.yml
!*.json
!*.ini
!*.conf

# Web 前端资源
!*.html
!*.css
!*.js
!*.ts
!*.vue
!*.scss
!*.wasm
!*.map

# 字体文件
!*.woff
!*.woff2
!*.ttf

# 文档与文本
!*.md
!*.txt

# 图片资源（docs 截图、static 静态资源）
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.ico

# 音频资源（报警语音 MP3，static/alarm_mp3/）
!*.mp3

# RK3588 平台头文件（libs/librga/include/）
!*.h

# 共享库与二进制（平台相关库，如 RK3588 RGA 库）
!*.so
!*.dll

# ========================================
# 允许上传的根文件（无扩展名，需显式列出）
# ========================================
!.gitignore
!LICENSE
!VERSION
!requirements.txt

# ========================================
# 显式忽略：即使符合上述类型也不追踪
# ========================================
# 模型文件（体积大，通过算法管理页面上传，不提交仓库）
*.onnx
*.rknn
*.pt
*.pth
*.engine
*.plan

# 数据库文件
*.db
*.db-shm
*.db-wal
*.db.bak

# 视频/媒体文件（体积大）
*.mp4
*.avi
*.mkv
*.mov
*.wmv
*.flv

# 日志文件
*.log

# 证书与密钥（敏感信息）
*.pem
*.key
*.crt

# 环境变量与密钥配置
*.env

# Python 编译缓存
*.pyc
*.pyo

# ========================================
# 显式忽略的目录（运行时产物 / IDE / 第三方）
# ========================================
# Python 缓存
__pycache__/

# 运行时输出（事件图片、GIF）
output/

# 日志目录
logs/

# TensorRT 引擎缓存
trt_cache/

# AI 流状态标记（运行时生成）
data/ai_stream_flags/

# 上传的视频文件
uploads/video_files/

# 第三方参考项目（不提交）
frigate/

# IDE 与调试目录
.trae/
.dbg/
.idea/
.vscode/

# Python 虚拟环境
.venv/
venv/
env/
ENV/

# 临时文件
*.tmp
*.temp
*.swp
*.swo
*.bak

# 临时分析脚本（调试用）
analyze_*.py
check_*.py
diagnose_*.py
monitor_*.py
debug_*.py
fix_*.py
verify_*.py
show_*.py
complete_*.py
quick_*.py
final_*.py
emergency_*.py
build_*.py
download_*.py
create_*.py

# 共享内存清理脚本（运行时工具，不提交）
scripts/cleanup_shared_memory.py

# 测试产物
benchmark_output.txt
process_analysis.txt
